# docker-compose.yml — managed by Ansible.  Do not edit manually.

services:

  caddy:
    image: {{ caddy_image_name }}:latest
    container_name: caddy
    restart: unless-stopped
    ports:
      - "{{ caddy_http_port }}:80"
      - "{{ caddy_https_port }}:443"
    volumes:
      - {{ caddy_config_path }}/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ caddy_data_volume }}:/data
      - {{ caddy_config_volume }}:/config
    environment:
      # AWS credentials for Route53 DNS-01 challenge.
      # Values are injected from Ansible Vault at deploy time — never hardcoded.
      AWS_ACCESS_KEY_ID: "{{ vault_caddy_aws_access_key_id }}"
      AWS_SECRET_ACCESS_KEY: "{{ vault_caddy_aws_secret_access_key }}"
{% if vault_caddy_aws_hosted_zone_id is defined %}
      AWS_HOSTED_ZONE_ID: "{{ vault_caddy_aws_hosted_zone_id }}"
{% endif %}

volumes:
  {{ caddy_data_volume }}:
  {{ caddy_config_volume }}:
