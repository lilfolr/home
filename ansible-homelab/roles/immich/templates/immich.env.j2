# roles/immich/templates/immich.env.j2
# Managed by Ansible — do not edit manually.
# Variables sourced from host_vars/mini-server.yml and group_vars/all/vault.yml

# ── Immich version ────────────────────────────────────────────────────────────
# Pin to a specific release tag (e.g. v1.106.4) or use "release" for latest stable
IMMICH_VERSION={{ immich_version }}

# ── Upload/library location ───────────────────────────────────────────────────
UPLOAD_LOCATION={{ immich_upload_path }}

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME={{ immich_db_username }}
DB_PASSWORD={{ vault_immich_db_password }}
DB_DATABASE_NAME={{ immich_db_name }}
DB_DATA_LOCATION={{ immich_db_data_path }}
# DB_HOSTNAME is set internally by Docker networking — do not override here.

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ={{ ansible_date_time.tz | default('UTC') }}
